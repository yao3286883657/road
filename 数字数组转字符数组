题目示例洛谷p1957:
#include <stdio.h>
#include <string.h>
int main(void){
  int n;
  char b[105];                        
  scanf("%d",&n);
  char t='a';                        //定符号，方便与下次输入的符号进行比较
  int x,y;
  for(int i=0;i<n;i++){
    char first[32];                  
    scanf("%31s",first);             //检测如果是字母，则更新定符号，否则将输入的数赋予x
    if(first[0]>='a' &&first[0]<='c'){
      t=first[0];
      scanf("%d %d",&x.&y);
    }else{
      sscanf(first,"%d",&x);
      scanf("%d",&y);
    }
    char sign;
    int sum;                          //分类
    if(t=='a'){
      sign='+';
      sum=x+y;
    }else if(t=='b'){
      sign='-';
      sum=x-y;
    }else if(t=='c'){
      sign='*';
      sum=x*y;
    }
    sprintf(b,"%d%c%d=%d",x,sign,y,sum);    //算式转字符串
    printf("%s\n%d\n",b,(int)strlen(b));    //输出字符串与长度
  }
  return 0;
}
