如洛谷P1308：
#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main(void) {
	char a[25];
	if (scanf("%s", a) != 1)return 1;
	a[strcspn(a, "\r\n")] = '\0';					//清除缓存区中的'\n'与'\r'
      /*这里也可用getchar():
                        int c;
                        whiel((c=getchar())!='\n'&&c!=EOF){}
      */
	char temp[1005];
	fgets(temp, sizeof(temp), stdin);
	char* first= NULL;
	char* p = temp;
	int len = strlen(a);
	while ((p = strstr(p, a)) != NULL) {			//strstr查找p中与a串完全相等的串，并返回下标，若无则为NULL
		int left = (p == temp) || !isalpha(p[-1]);	//这里isalpha主要是为了确定这个下标的前一位是不是字符，若是则表明找到的串只是某一长串的部分
		int right = !isalpha(p[len]);				//这里同上
		if (left&&right) {
			if (first == NULL) {
				first = p;							//这里是确定是第一次找到这个串
			}
		}
		p++;										//递增，逐项寻找
	}
	if (first != NULL)
		printf("%p", first);
	else printf(" - 1");
	return 0;
}
